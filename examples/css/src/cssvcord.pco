       IDENTIFICATION DIVISION.
       PROGRAM-ID. CSSVCORD.
      *****************************************************************
      * CSS ONLINE - SERVICE ORDER CREATION.  STAMPS THE CUSTOMER    *
      * NAME ONTO THE WORK ORDER, INSERTS IT, AND HANDS THE NAME TO  *
      * THE TECH-NOTES FORMATTER.                                    *
      *****************************************************************
       ENVIRONMENT DIVISION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
           EXEC SQL INCLUDE SQLCA END-EXEC.
           EXEC SQL BEGIN DECLARE SECTION END-EXEC.
           EXEC SQL INCLUDE CSCUST END-EXEC.
           EXEC SQL INCLUDE CSSVC END-EXEC.
           EXEC SQL END DECLARE SECTION END-EXEC.
       01  WS-NEXT-ORDER            PIC S9(10)      COMP-3.
       PROCEDURE DIVISION.
       0000-MAIN.
           MOVE 100045 TO CS-CUST-ID
           MOVE 500912 TO CS-SVC-ACCT-NBR
           PERFORM 1000-GET-CUSTOMER
           PERFORM 2000-CREATE-ORDER
           STOP RUN.

       1000-GET-CUSTOMER.
           EXEC SQL
               SELECT CUST_NAME
                 INTO :CS-CUST-NAME
                 FROM CSS_CUSTOMER
                WHERE CUST_ID = :CS-CUST-ID
           END-EXEC.

       2000-CREATE-ORDER.
           MOVE 9000000123 TO CS-SVC-ORDER-NBR
           MOVE 'INSTALL' TO CS-SVC-TYPE
           MOVE 'OP' TO CS-SVC-STATUS
           MOVE CS-CUST-NAME TO CS-SVC-CUST-NAME
           EXEC SQL
               INSERT INTO CSS_SVC_ORDER
                      (SVC_ORDER_NBR, SVC_ACCT_NBR, SVC_CUST_NAME,
                       SVC_TYPE, SVC_STATUS)
               VALUES (:CS-SVC-ORDER-NBR, :CS-SVC-ACCT-NBR,
                       :CS-SVC-CUST-NAME, :CS-SVC-TYPE, :CS-SVC-STATUS)
           END-EXEC
           CALL 'CSNOTES' USING CS-SVC-CUST-NAME CS-SVC-TECH-NOTES.
